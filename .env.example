# ============================================================
# Lantern — environment variables
# Copy to .env (frontend) and set as Edge Function secrets.
# NEVER commit real keys.
# ============================================================

# --- Frontend (injected into app.html's window.SUPABASE_CONFIG) ---
# Leave empty to run in demo mode with sample data.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Edge Function secrets (supabase secrets set ...) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=

# --- Local dev (supabase start) ---
# Test OTP is configured in supabase/config.toml as 123456
