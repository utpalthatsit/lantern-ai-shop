# ============================================================
# ShopSathi — environment variables
# Copy to .env (local) / Vercel project settings (production).
# NEVER commit real keys. Names only — values stay in your
# password manager, .env.local (gitignored) or Vercel dashboard.
# ============================================================

# ---- REQUIRED: Supabase (app cannot run without these) ----
# From Supabase dashboard → Settings → API.
# SUPABASE_URL is the project URL, e.g. https://xxxx.supabase.co
# SUPABASE_ANON_KEY is the *anon* (public) key. It ships in the
# browser by design — RLS is what protects the data, never rely
# on the anon key being secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- AI assistant (Edge functions) ----
# REQUIRED for the AI Assistant, WhatsApp AI replies, business
# summaries and marketing drafts. Set ONE provider:
#
# OPTION 1 (FREE): Google Gemini — free tier is enough for a small
# shop. Get a key at https://aistudio.google.com/apikey (free, just
# needs a Google account). Set with:
#   supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
#
# OPTION 2: Anthropic Claude (paid, one-time free trial credit on
# new accounts). Set with:
#   supabase secrets set ANTHROPIC_API_KEY=... ANTHROPIC_MODEL=...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- WhatsApp Business Cloud API (function `whatsapp-webhook`) ----
# REQUIRED for real WhatsApp messaging. Get these from the Meta
# developer dashboard (app → WhatsApp → API setup).
WHATSAPP_TOKEN=                 # permanent access token
WHATSAPP_PHONE_NUMBER_ID=       # the business phone number ID
WHATSAPP_APP_SECRET=            # app secret, used to verify webhook signatures
WHATSAPP_VERIFY_TOKEN=          # any random string you choose, set in Meta too

# ---- Scheduled jobs (daily summary + booking reminders) ----
# Create database schedules in Supabase with pg_cron:
#   select cron.schedule('shopsathi-daily-summary', '30 8 * * *',
#     $$select net.http_post(url:=concat('https://<project-ref>.functions.supabase.co/business-summary'), headers:=jsonb_build_object('Authorization', 'Bearer <anon-key>'))$$);
# See README → "Scheduled jobs" for the full SQL.
