{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/inject-env.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/((?!assets/|css/|js/|app\\.html|index\\.html|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
